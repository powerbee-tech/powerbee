{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/powerbee-visionary-launch",
      "destination": "https://powerbee.tech/",
      "statusCode": 301
    },
    {
      "source": "/powerbee-visionary-launch/:path*",
      "destination": "https://powerbee.tech/",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck/",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    },
    {
      "source": "/polishengine-deck/:path*",
      "destination": "https://powerbee.tech/polishengine",
      "statusCode": 301
    },
    {
      "source": "/deck",
      "destination": "https://powerbee.tech/powerbee",
      "statusCode": 301
    },
    {
      "source": "/deck/",
      "destination": "https://powerbee.tech/powerbee",
      "statusCode": 301
    },
    {
      "source": "/deck/:path*",
      "destination": "https://powerbee.tech/powerbee/:path*",
      "statusCode": 301
    },
    {
      "source": "/powerbee-1",
      "destination": "https://powerbee.tech/powerbee",
      "statusCode": 301
    },
    {
      "source": "/powerbee-1/",
      "destination": "https://powerbee.tech/powerbee",
      "statusCode": 301
    },
    {
      "source": "/powerbee-1/:path*",
      "destination": "https://powerbee.tech/powerbee/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, max-snippet:-1, max-image-preview:large" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/:path((?!assets/|robots\\.txt|sitemap\\.xml|favicon).+)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/powerbee/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/polishengine/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/polishengine/pitch/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/powerbee/media/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
